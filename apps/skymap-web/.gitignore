dist.zip

# 打包脚本 tools/make-dist-zip.sh 的暂存目录与半成品（正常结束会自删）。
# dist.zip.tmp 必须单列：上面那条是字面量 dist.zip，盖不住 .tmp 后缀，
# 而打包中途崩掉会留下一个 74MB 的未跟踪文件，`git add -A` 就会把它暂存进来。
.dist-stage
dist.zip.tmp
